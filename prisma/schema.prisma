// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  // 수술명 자동 생성 표기 설정
  sideNotation      String  @default("full") // "full" | "paren" | "bracket"
  abbreviateRegions Boolean @default(false)
  // 기록지 작성 시 기본값으로 채워줄 보조의 이름 (매번 같은 사람과 수술하는 경우가 많아 입력을 줄여줌)
  defaultAssistantName String?
  // 구글 캘린더 구독(.ics 피드) 주소에 들어가는 비밀 토큰 — 주소를 아는 사람은
  // 로그인 없이 이 계정의 수술 일정(수술명+날짜)을 읽을 수 있다. 다시 만들면 기존 주소는 무효.
  calendarToken        String?         @unique
  // 병원 PC 스크립트가 EMR 수술 일정을 이 계정의 수술 계획으로 올릴 때 쓰는 비밀 토큰
  // (POST /api/schedule-import, Authorization: Bearer). 다시 만들면 기존 토큰은 무효.
  importToken          String?         @unique
  // 리마인더 "동기화 요청" 버튼을 누른 시각 — 병원 PC가 평일 근무 시간에 10분마다 확인해
  // 요청이 있으면 EMR과 동기화하고 비운다.
  reminderSyncRequestedAt DateTime?
  // "TSA 기간 확인" 요청 — 병원 PC가 10분마다 확인해 그 기간 수술장 명단의 TSA를 구글 시트에 넣고 비운다.
  tsaScanFrom        String?
  tsaScanTo          String?
  tsaScanRequestedAt DateTime?
  // 로그인 실패 횟수와 잠금 시각 — 비밀번호를 계속 대입해 보는 것을 막는다.
  failedLoginCount     Int             @default(0)
  lockedUntil          DateTime?
  // 세션(로그인 쿠키)에 같이 넣어 두는 번호 — 비밀번호를 바꾸거나 "모든 기기에서
  // 로그아웃"을 누르면 올려서, 그 전에 발급된 다른 기기의 로그인을 모두 끊는다.
  sessionVersion       Int             @default(0)
  // 비밀번호 찾기 메일의 링크 토큰 — 원문은 메일에만 있고 여기엔 해시만 둔다.
  // 한 번 쓰거나 만료되면 지운다.
  resetTokenHash       String?         @unique
  resetTokenExpiresAt  DateTime?
  patients     Patient[]
  opPlans      OpPlan[]
  opRecords    OpRecord[]
  reminders    Reminder[]
  tsaRuns         TsaRun[]
  outpatientLists OutpatientList[]
  textTemplates   TextTemplate[]
  outpatientTemplates OutpatientTemplate[]
  emrSetOrders    EmrSetOrder[]
  deviceOtps      DeviceOtp[]
  deviceSessions  DeviceSession[]
  roadmapVersions RoadmapVersion[]
  visitNotes      VisitNote[]
  patientCares    PatientCare[]
  patientPathways PatientPathway[]
  visitSummaries  VisitSummary[]
  opdJobs         OpdJob[]
  rxBundles       RxBundle[]
  // 내 외래 스케줄 — [{ weekday: 0(일)~6(토), session: "AM" | "PM" }]. 다음 외래 날짜 계산에 쓴다(휴진은 AutomationPause)
  clinicSchedule  Json            @default("[]")
  automationPauses AutomationPause[]
  pcJobs          PcJobStatus[]
  profSchedules   ProfSchedule[]
}

// 수술 종류 (ESS, 비중격교정술, 기타 이비인후과 수술 등). fields 는 이 수술에 특화된
// 입력 항목 정의를 JSON 배열로 저장해서, 새 수술 종류를 코드 수정 없이 추가할 수 있게 한다.
model SurgeryType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  fields    Json
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  opPlans   OpPlan[]
}

model Patient {
  id          String   @id @default(cuid())
  chartNo     String?
  name        String
  sex         String?
  birthDate   DateTime?
  // 생년월일 대신 나이를 직접 입력받는다 (더 간단하고 실제로 쓰는 값이라).
  age         Int?
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  opPlans     OpPlan[]
  reminders   Reminder[]
}

// 환자별 리마인더 — EMR(YES) Reminder 기본 탭과 병원 PC 스크립트로 양방향 동기화한다.
// source "EMR": EMR에서 읽어 온 것(EMR이 원본, EMR에서 지워지면 여기서도 지움).
// source "ESS": 이 사이트에서 만든 것. 아직 EMR에 안 올라갔으면 emrRegSeq가 비어 있고,
// 병원 PC가 EMR에 추가한 뒤 EMR의 등록일·순번을 채운다(그 뒤로는 EMR 쪽이 원본).
model Reminder {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  content     String?
  authorName  String?
  source      String    @default("ESS")
  emrRegDate  String?
  emrRegSeq   String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([patientId, emrRegDate, emrRegSeq])
}

model OpPlan {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  surgeryTypeId String
  surgeryType   SurgeryType  @relation(fields: [surgeryTypeId], references: [id])
  plannedDate   DateTime?
  side          String?
  diagnosis     String?
  planNote      String?
  // 주호소(CC) — 수술 후 특이사항과 함께 차트 remark로 복사할 때 맨 앞에 들어간다.
  chiefComplaint String?
  // 수술 후 특이사항 — 기록지 본문과 별개로 차트 remark에 붙여넣을 짧은 메모.
  postOpRemark   String?
  // surgeryType.fields 의 key 에 대응하는 계획 단계 입력값 — 완료(DONE) 처리
  // 이후에는 더 이상 여기가 덮어써지지 않고, "수술 후" 화면(수술 방법) 수정은
  // actualData에만 반영된다. Op Plan 표는 항상 이 planData만 읽는다.
  planData      Json?
  // 완료 처리 이후 "수술 후" 화면에서 실제로 고친 수술 방법 값 — 기록지
  // 초안(recordText)만 이 값(있으면)을 planData보다 우선해서 읽는다.
  actualData    Json?
  status        String       @default("PLANNED")
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  opRecord      OpRecord?
}

model OpRecord {
  id                String   @id @default(cuid())
  opPlanId          String   @unique
  opPlan            OpPlan   @relation(fields: [opPlanId], references: [id], onDelete: Cascade)
  operationDate     DateTime
  surgeonName       String
  assistantName     String?
  anesthesiaType    String?
  preOpDiagnosis    String?
  postOpDiagnosis   String?
  procedureName     String?
  findings          String?
  procedureDetail   String?
  // surgeryType.fields 의 key 에 대응하는 실제 시행 결과값
  recordData        Json?
  estimatedBloodLoss String?
  specimen          String?
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 병원 PC가 TSA 구글 시트에 넣은 결과(평일 일일 실행·기간 확인). "병원 연동" 화면에 보여준다.
// held/dups에는 환자 이름 없이 수술일·등록번호 끝 4자리·시트 행 번호만 담는다.
model TsaRun {
  id          String   @id @default(cuid())
  kind        String // DAILY | RANGE
  rangeFrom   String
  rangeTo     String
  found       Int      @default(0)
  added       Int      @default(0)
  skipped     Int      @default(0)
  held        Json     @default("[]")
  dups        Json     @default("[]")
  error       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdById, createdAt])
}

// 병원 PC가 올리는 다음 날 외래 명단(텔레그램과 같은 내용). 로그인한 본인만 본다.
model OutpatientList {
  id          String   @id @default(cuid())
  date        String // yyyy-MM-dd
  clinic      String
  rows        Json // [{ time, name, chartNo, visit, diagnosis }]
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([createdById, date])
}

// 사용자가 만든 문구 템플릿 — 계획 메모·수술 후 특이사항 칸에 고르면 그대로 붙는다.
model TextTemplate {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

// 외래 템플릿(증상·진단별) — 진료실 PC 프로그램이 받아 EMR 외래초진/경과 기록지 칸을 채우고,
// 연결한 약속처방을 오더창에 넣는다(저장·전송은 사용자가 직접). 칸 이름은 EMR 기록지 탭과 같다.
// setOrders = [{ ownerEmpNo, key, name }] — EMR 약속처방 트리 노드 키(EmrSetOrder와 같은 키)
model OutpatientTemplate {
  id               String   @id @default(cuid())
  title            String
  kind             String   @default("symptom") // symptom(증상) | diagnosis(진단 받고 옴) | exam(검사, 비인강경)
  audience         String   @default("adult") // adult(성인) | child(소아) — 프로그램에서 Ctrl+Shift+A로 전환
  shortcut         Int? // 단축 번호 1~9 — 프로그램 Ctrl+Shift+번호(대상별로 따로)
  sortOrder        Int      @default(0)
  firstCc          String   @default("")
  firstPi          String   @default("")
  firstRos         String   @default("")
  firstPe          String   @default("")
  firstAssessment  String   @default("")
  firstPlan        String   @default("")
  followSubjective String   @default("")
  followObjective  String   @default("")
  followAssessment String   @default("")
  followPlan       String   @default("")
  dxCodes          String   @default("") // 진단 코드 "J342,J343" — 진료실 프로그램이 경증 아닌 첫 코드를 주진단, 나머지는 부상병
  setOrders        Json     @default("[]")
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdById])
}

// 진료실 PC 프로그램이 올린 EMR 약속처방 목록. ownerEmpNo = 그때 YES에 로그인한 사람의 사번
// (다른 사람이 자기 아이디로 로그인한 PC에서 올리면 그 사람 세트가 따로 쌓인다). 올릴 때마다 그 사번 목록을 통째로 바꾼다.
// lines = 세트 안 처방 줄(가져온 다른 사람 세트처럼 내 트리에 없는 세트를 넣을 때 쓴다). 폴더는 lines 없음
model EmrSetOrder {
  id          String   @id @default(cuid())
  ownerEmpNo  String
  ownerName   String   @default("")
  key         String
  path        String   @default("")
  name        String
  level       Int      @default(0)
  seq         Int      @default(0) // EMR 트리 순서
  lines       Json?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  syncedAt    DateTime @default(now())

  @@unique([createdById, ownerEmpNo, key])
}

// 진료실 PC 프로그램 연결용 1회 코드(6자리, 5분, 한 번만). 코드는 해시만 저장
model DeviceOtp {
  id          String    @id @default(cuid())
  codeHash    String
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([codeHash])
}

// 1회 코드로 연 진료실 PC 프로그램 세션 — 프로그램을 끄면 끊는다(최대 16시간). 토큰은 해시만 저장
model DeviceSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  expiresAt   DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// 1회 코드가 틀린 시도 — 짧은 시간에 몰리면 연결을 잠시 막는다(서버리스라 DB에 남김)
model DeviceOtpFailure {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 환자별 로드맵(경과·현재·할 일·확인) 이력 — 최신 것이 지금 로드맵. source: soap(외래 전날 자동) | visit(진료 후 갱신)
// done = 체크한 할 일 줄(글 그대로)
model RoadmapVersion {
  id          String   @id @default(cuid())
  chartNo     String
  text        String
  source      String
  done        Json     @default("[]")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdById, chartNo, createdAt])
}

// 처방 묶음(약물치료) — 진료실 프로그램이 오더 표에 바로 넣는다(EMR 세트 대신). items = [{ code, name, dose, freq, days, ped? }]
// 소아(audience=child)는 약마다 계산 규칙(ped: 나이 구간 / 체중당 mg / 체중 구간)으로 나이·몸무게에 맞춰 1회량·용법을 정한다
model RxBundle {
  id          String   @id @default(cuid())
  title       String
  audience    String   @default("adult")
  sortOrder   Int      @default(0)
  items       Json     @default("[]")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

// 환자별 관리 방향 — 진료실 프로그램에서 Plan(수술/약물치료/경과관찰)과 다음 외래를 고른다. 로드맵 갱신 때 함께 본다
model PatientCare {
  id             String   @id @default(cuid())
  chartNo        String
  planType       String? // surgery | medication | observation
  nextVisit      String? // yyyy-MM-dd(서울)
  nextVisitLabel String? // "4주" 등 고른 간격
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  updatedAt      DateTime @updatedAt

  @@unique([createdById, chartNo])
}

// 환자별 진료 경로(src/lib/pathways.ts)와 지금 단계 — AI가 제안(confirmed=false면 바로 바꿈), 의사가 확정하면 AI는 제안만 남긴다.
// history = [{ stageId, date, by: ai|doctor }]. 한 환자 경로 최대 2개
model PatientPathway {
  id              String   @id @default(cuid())
  chartNo         String
  pathwayId       String
  stageId         String
  confirmed       Boolean  @default(false)
  proposedStageId String?
  proposedReason  String?
  startedAt       String // yyyy-MM-dd(서울)
  history         Json     @default("[]")
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  updatedAt       DateTime @updatedAt

  @@unique([createdById, chartNo, pathwayId])
}

// 노트북에 맡긴 외래 일감(진료 어시스트 [오늘 외래] → 노트북 작업자). tasks = { note, dx, scope }, templateId = 쓸 템플릿.
// status: pending(대기) → running(처리 중) → done / failed / waiting(접수 전 등, 나중에 다시). practice면 EMR에 쓰지 않고 할 일만 보고
model OpdJob {
  id          String   @id @default(cuid())
  visitDate   String // yyyy-MM-dd(서울)
  chartNo     String
  name        String   @default("") // 가린 이름(명단과 같음)
  visit       String   @default("") // 초진/재진/재초
  templateId  String?
  tasks       Json     @default("{}")
  practice    Boolean  @default(false)
  status      String   @default("pending")
  result      String?
  tries       Int      @default(0)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([createdById, visitDate, chartNo])
}

// 외래별 요약(로드맵의 외래 버튼) — AI가 기록으로 만든다. 그 외래 때 단계(pathwayId·stageId)를 같이 남긴다
model VisitSummary {
  id          String   @id @default(cuid())
  chartNo     String
  visitDate   String // yyyy-MM-dd
  summary     String
  pathwayId   String?
  stageId     String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([createdById, chartNo, visitDate])
}

// 진료실 프로그램 [로드맵 저장]으로 올린 그날 기록지 글 — 저녁에 노트북이 모아 로드맵을 갱신하고 processedAt을 찍는다
model VisitNote {
  id          String    @id @default(cuid())
  chartNo     String
  visitDate   String // yyyy-MM-dd(서울)
  kind        String // first | follow
  text        String
  processedAt DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([createdById, chartNo, visitDate])
}

// 병원 PC 작업(수술 일정·리마인더·외래 명단·TSA)의 마지막 실행 — "병원 연동" 화면 상태판.
// 작업마다 한 줄을 덮어쓴다(10분마다 도는 확인 작업도 줄이 늘지 않게).
model PcJobStatus {
  id            String    @id @default(cuid())
  job           String
  lastRunAt     DateTime
  lastOk        Boolean
  lastMessage   String?
  lastFailureAt DateTime?
  lastFailure   String?
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  updatedAt     DateTime  @updatedAt

  @@unique([createdById, job])
}

// 병원 PC 자동화 쉬는 날(출장 등) — 그 기간에는 병원 PC가 EMR에 접속하는 작업을 모두 건너뛴다(사용자 요청 2026-10-21).
// 날짜는 yyyy-MM-dd(서울), from~to 포함.
model AutomationPause {
  id          String   @id @default(cuid())
  from        String
  to          String
  note        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdById])
}

// 교수님별 외래 인원·수술(캘린더, 사용자 2026-10-25) — 병원 PC가 평일 아침 앞으로 2주치를 올린다(prof_schedule.ps1).
// surgeries: [{ name(가운데 가림), age, sex, chartNo, op }] — 텔레그램 수술 알림과 같은 수준. 기간을 올리면 그 기간은 통째로 바꾼다
model ProfSchedule {
  id          String   @id @default(cuid())
  date        String
  doctor      String
  outpatient  Int      @default(0)
  surgeries   Json     @default("[]")
  // 그날 교수님 부재 — "휴가"·"출장"·"반일 휴가"로만(사유·종류는 안 남김, 2026-10-26). YES 개인별복무현황조회에서 병원 PC가 읽음
  off         String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([createdById, date, doctor])
}
