// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  // 수술명 자동 생성 표기 설정
  sideNotation      String  @default("full") // "full" | "paren" | "bracket"
  abbreviateRegions Boolean @default(false)
  // 기록지 작성 시 기본값으로 채워줄 보조의 이름 (매번 같은 사람과 수술하는 경우가 많아 입력을 줄여줌)
  defaultAssistantName String?
  patients     Patient[]
  opPlans      OpPlan[]
  opRecords    OpRecord[]
  surgeryPresets SurgeryPreset[]
}

// 수술 종류 (ESS, 비중격교정술, 기타 이비인후과 수술 등). fields 는 이 수술에 특화된
// 입력 항목 정의를 JSON 배열로 저장해서, 새 수술 종류를 코드 수정 없이 추가할 수 있게 한다.
model SurgeryType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  fields    Json
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  opPlans   OpPlan[]
  presets   SurgeryPreset[]
}

// 자주 쓰는 필드 조합을 이름 붙여 저장해두는 세트 — 클릭 한 번으로 전체 항목을
// 불러올 수 있게 해서 반복적인 수술의 계획/기록 작성 클릭 수를 줄인다.
model SurgeryPreset {
  id            String      @id @default(cuid())
  name          String
  surgeryTypeId String
  surgeryType   SurgeryType @relation(fields: [surgeryTypeId], references: [id], onDelete: Cascade)
  fieldValues   Json
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model Patient {
  id          String   @id @default(cuid())
  chartNo     String?
  name        String
  sex         String?
  birthDate   DateTime?
  // 생년월일 대신 나이를 직접 입력받는다 (더 간단하고 실제로 쓰는 값이라).
  age         Int?
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  opPlans     OpPlan[]
}

model OpPlan {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  surgeryTypeId String
  surgeryType   SurgeryType  @relation(fields: [surgeryTypeId], references: [id])
  plannedDate   DateTime?
  side          String?
  diagnosis     String?
  planNote      String?
  // surgeryType.fields 의 key 에 대응하는 계획 단계 입력값
  planData      Json?
  status        String       @default("PLANNED")
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  opRecord      OpRecord?
}

model OpRecord {
  id                String   @id @default(cuid())
  opPlanId          String   @unique
  opPlan            OpPlan   @relation(fields: [opPlanId], references: [id], onDelete: Cascade)
  operationDate     DateTime
  surgeonName       String
  assistantName     String?
  anesthesiaType    String?
  preOpDiagnosis    String?
  postOpDiagnosis   String?
  procedureName     String?
  findings          String?
  procedureDetail   String?
  // surgeryType.fields 의 key 에 대응하는 실제 시행 결과값
  recordData        Json?
  complication      String?
  estimatedBloodLoss String?
  specimen          String?
  postOpPlan        String?
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
