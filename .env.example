# Postgres 연결 문자열 (예: Vercel Postgres/Neon, 또는 로컬 postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/essapp"

# openssl rand -base64 32 로 생성해서 채워주세요.
SESSION_SECRET="change-me"

# 가입을 허용할 이메일(쉼표로 구분). 비어 있으면 회원가입이 전부 차단됩니다.
ALLOWED_EMAILS=you@example.com

# 비밀번호 찾기 메일 발송(SMTP) — 비워 두면 비밀번호 찾기 화면이 "관리자에게 문의" 안내만 보여줍니다.
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=계정@gmail.com,
#           SMTP_PASS=Google 계정 > 보안 > 앱 비밀번호(16자리)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 보내는 사람 주소(비우면 SMTP_USER)
MAIL_FROM=
# 메일 속 재설정 링크의 앱 주소(예: https://내-앱.vercel.app). Vercel에선 비워도 기본 도메인을 씁니다.
APP_URL=
